<Window x:Class="com_capture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="串口转发 - COM Capture"
        Height="680"
        Width="1040"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#F5F5F5"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Settings -->
        <Border Grid.Row="0"
                Padding="16,12"
                CornerRadius="6"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">
            <StackPanel>
                <TextBlock Text="串口设置"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="串口 1："
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="Port1Combo"
                              Grid.Column="1"
                              Height="28"
                              IsEditable="True"
                              IsReadOnly="True"
                              VerticalContentAlignment="Center"
                              ToolTip="选择串口 1（数据流向：串口 1 → 串口 2）"/>

                    <TextBlock Grid.Column="2" Text="串口 2："
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <ComboBox x:Name="Port2Combo"
                              Grid.Column="3"
                              Height="28"
                              IsEditable="True"
                              IsReadOnly="True"
                              VerticalContentAlignment="Center"
                              ToolTip="选择串口 2（数据流向：串口 2 → 串口 1）"/>

                    <TextBlock Grid.Column="4" Text="波特率："
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBox x:Name="BaudTextBox"
                             Grid.Column="5"
                             Text="9600"
                             Height="28"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             ToolTip="波特率，默认 9600，可改为任意合法值（如 19200、115200）"
                             PreviewTextInput="BaudTextBox_PreviewTextInput"
                             DataObject.Pasting="BaudTextBox_Pasting"
                             InputMethod.IsInputMethodEnabled="False"/>

                    <Button x:Name="RefreshButton"
                            Grid.Column="6"
                            Content="刷新"
                            Margin="12,0,8,0"
                            Padding="14,6"
                            Click="RefreshButton_Click"
                            ToolTip="重新扫描可用串口"/>

                    <ToggleButton x:Name="StartToggle"
                                  Grid.Column="7"
                                  Content="开始转发"
                                  Width="104"
                                  Height="28"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Click="StartToggle_Click"
                                  ToolTip="打开两个串口并开始双向转发"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="未连接"
                               Foreground="#888888"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatsText"
                               Text=""
                               Foreground="#666666"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Communication log -->
        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="16,12"
                CornerRadius="6"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="通讯记录"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="AutoScrollCheck"
                                  Content="自动滚动"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"/>
                        <Button x:Name="ClearButton"
                                Content="清空"
                                Padding="14,5"
                                Click="ClearButton_Click"
                                ToolTip="清空当前记录"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="时间" Foreground="#888888" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="方向" Foreground="#888888" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="长度" Foreground="#888888" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="数据 (HEX)" Foreground="#888888" FontSize="12" Margin="8,0,8,0"/>
                    <TextBlock Grid.Column="4" Text="数据 (ASCII)" Foreground="#888888" FontSize="12"/>
                </Grid>

                <ListBox x:Name="LogList"
                         Grid.Row="2"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"
                         Background="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#777777"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DirectionText}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding DirectionColor}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding LenText}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding HexText}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="8,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding AsciiText}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#444444"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
