<Window x:Class="binder_chamber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:binder_chamber"
        mc:Ignorable="d"
        Title="BINDER Chamber" Height="640" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Device discovery -->
        <Border Grid.Row="0"
                Padding="16,12"
                CornerRadius="6"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">
            <StackPanel>
                <TextBlock Text="DEVICE DISCOVERY"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Chamber IP:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <ComboBox x:Name="ChamberComboBox"
                              Grid.Column="1"
                              Height="28"
                              VerticalContentAlignment="Center"
                              IsEditable="True"
                              ToolTip="Select or type a chamber IP address"/>

                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Content="Refresh"
                            Margin="10,0,10,0"
                            Padding="12,5"
                            Click="RefreshButton_Click"
                            ToolTip="Discover BINDER chambers on the network"/>

                    <Button x:Name="ConnectButton"
                            Grid.Column="3"
                            Content="Connect"
                            Margin="0,0,30,0"
                            Padding="12,5"
                            Click="ConnectButton_Click"
                            ToolTip="Connect to the selected chamber"/>

                    <TextBlock Grid.Column="4" Text="Protocol:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock x:Name="ProtocolText"
                               Grid.Column="5"
                               Text="UDP 30718 / TCP 10001"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Grid>

                <!-- Pipe server settings -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pipe name:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="PipeNameTextBox"
                             Grid.Column="1"
                             Text="binder_chamber"
                             Height="26"
                             VerticalContentAlignment="Center"
                             ToolTip="Named pipe server name"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ApplyPipeButton"
                                Content="Apply"
                                Margin="10,0,4,0"
                                Padding="12,5"
                                Click="ApplyPipeButton_Click"
                                ToolTip="Restart the pipe server with this name"/>
                        <ToggleButton x:Name="PipeToggleButton"
                                      Content="Pipe: ON"
                                      IsChecked="True"
                                      Width="86"
                                      Height="28"
                                      Padding="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Checked="PipeToggle_Checked"
                                      Unchecked="PipeToggle_Unchecked"
                                      ToolTip="Enable / disable the named pipe server"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Chamber status + control panels -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chamber status panel -->
            <Border Grid.Column="0"
                    Padding="16,12"
                    CornerRadius="6"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Background="White">
                <StackPanel>
                    <TextBlock Text="CHAMBER STATUS"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current temperature"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="CurrentTempText" Grid.Row="0" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target temperature"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="TargetTempText" Grid.Row="1" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Current humidity"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="CurrentHumidityText" Grid.Row="2" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Target humidity"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="TargetHumidityText" Grid.Row="3" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fan setpoint"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="FanSpText" Grid.Row="4" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Control panel -->
            <Border Grid.Column="2"
                    Padding="16,12"
                    CornerRadius="6"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Background="White">
                <StackPanel>
                    <TextBlock Text="CONTROL"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Set temperature (°C)"
                                   VerticalAlignment="Center"
                                   Margin="0,4,8,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SetTempTextBox"
                                     Width="90"
                                     Height="26"
                                     VerticalContentAlignment="Center"
                                     Margin="0,4,8,4"
                                     ToolTip="e.g. 27.0 or -10.0"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                            <Button x:Name="SetTempButton"
                                    Content="Set"
                                    Padding="12,4"
                                    Margin="0,4,0,4"
                                    Click="SetTempButton_Click"
                                    ToolTip="Write target temperature"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Set humidity (%RH)"
                                   VerticalAlignment="Center"
                                   Margin="0,4,8,4"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SetHumidityTextBox"
                                     Width="90"
                                     Height="26"
                                     VerticalContentAlignment="Center"
                                     Margin="0,4,8,4"
                                     ToolTip="e.g. 50.0"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                            <Button x:Name="SetHumidityButton"
                                    Content="Set"
                                    Padding="12,4"
                                    Margin="0,4,0,4"
                                    Click="SetHumidityButton_Click"
                                    ToolTip="Write target humidity"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Run / Stop"
                                   VerticalAlignment="Center"
                                   Margin="0,4,8,4"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="StartButton"
                                    Content="Start"
                                    Padding="12,4"
                                    Margin="0,4,8,4"
                                    IsEnabled="False"
                                    Click="StartButton_Click"
                                    ToolTip="Start / stop is not supported on this device"/>
                            <Button x:Name="StopButton"
                                    Content="Stop"
                                    Padding="12,4"
                                    Margin="0,4,0,4"
                                    IsEnabled="False"
                                    Click="StopButton_Click"
                                    ToolTip="Start / stop is not supported on this device"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Set fan speed (%)"
                                   VerticalAlignment="Center"
                                   Margin="0,4,8,4"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SetFanTextBox"
                                     Width="90"
                                     Height="26"
                                     VerticalContentAlignment="Center"
                                     Margin="0,4,8,4"
                                     ToolTip="e.g. 50 (range 30..100)"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                            <Button x:Name="SetFanButton"
                                    Content="Set"
                                    Padding="12,4"
                                    Margin="0,4,0,4"
                                    Click="SetFanButton_Click"
                                    ToolTip="Write fan speed setpoint (30..100 %)"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Temperature / humidity linear ramp control -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16,12"
                CornerRadius="6"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Temperature ramp -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TEMPERATURE RAMP"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TempRampStatusText"
                               Text="Idle"
                               FontSize="13"
                               Foreground="#555555"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Start (°C)" Margin="0,0,0,4"/>
                            <TextBox x:Name="StartTempTextBox"
                                     Width="70"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ramp start temperature, e.g. 25.0"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="End (°C)" Margin="0,0,0,4"/>
                            <TextBox x:Name="EndTempTextBox"
                                     Width="70"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ramp end temperature, e.g. 60.0"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Time (s)" Margin="0,0,0,4"/>
                            <TextBox x:Name="DurationTempTextBox"
                                     Width="70"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ramp duration in whole seconds"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="StartTempRampButton"
                                Content="Start"
                                Padding="12,4"
                                Margin="0,0,8,0"
                                Click="StartTempRampButton_Click"
                                ToolTip="Start the temperature linear ramp"/>
                        <Button x:Name="StopTempRampButton"
                                Content="Stop"
                                Padding="12,4"
                                Click="StopTempRampButton_Click"
                                ToolTip="Stop the temperature linear ramp"/>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="1"
                        Width="1"
                        Margin="24,0"
                        Background="#E0E0E0"/>

                <!-- Humidity ramp -->
                <StackPanel Grid.Column="2" Margin="24,0,0,0">
                    <TextBlock Text="HUMIDITY RAMP"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="HumRampStatusText"
                               Text="Idle"
                               FontSize="13"
                               Foreground="#555555"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Start (%RH)" Margin="0,0,0,4"/>
                            <TextBox x:Name="StartHumTextBox"
                                     Width="70"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ramp start humidity, e.g. 30.0"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="End (%RH)" Margin="0,0,0,4"/>
                            <TextBox x:Name="EndHumTextBox"
                                     Width="70"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ramp end humidity, e.g. 80.0"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Time (s)" Margin="0,0,0,4"/>
                            <TextBox x:Name="DurationHumTextBox"
                                     Width="70"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ramp duration in whole seconds"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="StartHumRampButton"
                                Content="Start"
                                Padding="12,4"
                                Margin="0,0,8,0"
                                Click="StartHumRampButton_Click"
                                ToolTip="Start the humidity linear ramp"/>
                        <Button x:Name="StopHumRampButton"
                                Content="Stop"
                                Padding="12,4"
                                Click="StopHumRampButton_Click"
                                ToolTip="Stop the humidity linear ramp"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
