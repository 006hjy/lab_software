<Window x:Class="start.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:start"
        mc:Ignorable="d"
        Title="Start - Launch Programs"
        Width="660" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Scan root -->
        <TextBlock x:Name="RootText"
                   DockPanel.Dock="Top"
                   Margin="10,10,10,4"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Action buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Margin="10,6"
                    HorizontalAlignment="Right">
            <Button Content="Select All" Width="86" Padding="8,3" Margin="0,0,6,0" Click="OnSelectAllClicked"/>
            <Button Content="Select None" Width="86" Padding="8,3" Margin="0,0,6,0" Click="OnSelectNoneClicked"/>
            <Button Content="Refresh" Width="72" Padding="8,3" Margin="0,0,10,0" Click="OnRefreshClicked"/>
            <Button Content="Start" Width="90" Padding="8,3" Click="OnStartClicked"/>
            <Button Content="Close" Width="90" Padding="8,3" Margin="6,0,0,0" Click="OnCloseClicked"/>
        </StackPanel>

        <!-- Executable checklist -->
        <ListBox x:Name="ExeList" Margin="10,4,10,4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Display}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              ToolTip="{Binding FullPath}"
                              Checked="OnItemToggled"
                              Unchecked="OnItemToggled"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
