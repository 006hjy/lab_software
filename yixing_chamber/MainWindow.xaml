<Window x:Class="yixing_chamber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:yixing_chamber"
        mc:Ignorable="d"
        Title="Yixing Chamber" Height="560" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Serial port settings -->
        <Border Grid.Row="0"
                Padding="16,12"
                CornerRadius="6"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">
            <StackPanel>
                <TextBlock Text="SERIAL SETTINGS"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Port:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="PortComboBox"
                              Grid.Column="1"
                              Height="28"
                              VerticalContentAlignment="Center"
                              ToolTip="Select a serial port"/>
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Content="Refresh"
                            Margin="10,0,10,0"
                            Padding="12,5"
                            Click="RefreshButton_Click"
                            ToolTip="Scan for available serial ports"/>
                    <Button x:Name="ConnectButton"
                            Grid.Column="3"
                            Content="Connect"
                            Margin="0,0,30,0"
                            Padding="12,5"
                            Click="ConnectButton_Click"
                            ToolTip="Connect to the selected port"/>
                    <TextBlock Grid.Column="4" Text="Baud rate:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="5"
                               Text="9600"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Grid>

                <!-- Pipe server settings -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pipe name:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="PipeNameTextBox"
                             Grid.Column="1"
                             Text="yixing_chamber"
                             Height="26"
                             VerticalContentAlignment="Center"
                             ToolTip="Named pipe server name"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ApplyPipeButton"
                                Content="Apply"
                                Margin="10,0,4,0"
                                Padding="12,5"
                                Click="ApplyPipeButton_Click"
                                ToolTip="Restart the pipe server with this name"/>
                        <ToggleButton x:Name="PipeToggleButton"
                                      Content="Pipe: ON"
                                      IsChecked="True"
                                      Width="86"
                                      Height="28"
                                      Padding="0"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Checked="PipeToggle_Checked"
                                      Unchecked="PipeToggle_Unchecked"
                                      ToolTip="Enable / disable the named pipe server"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ConnectionStatusText"
                           Foreground="#C0504D"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Chamber status + control -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status panel -->
            <Border Grid.Column="0"
                    Padding="16,12"
                    CornerRadius="6"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Background="White">
                <StackPanel>
                    <TextBlock Text="CHAMBER STATUS"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current temperature"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="CurrentTempText" Grid.Row="0" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target temperature"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="TargetTempText" Grid.Row="1" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Run state"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="RunStateText" Grid.Row="2" Grid.Column="1"
                                   Text="--"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,4,0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Control panel -->
            <Border Grid.Column="2"
                    Padding="16,12"
                    CornerRadius="6"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Background="White">
                <StackPanel>
                    <TextBlock Text="CONTROL"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Set temperature (°C)"
                                   VerticalAlignment="Center"
                                   Margin="0,4,8,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="SetTempTextBox"
                                     Width="90"
                                     Height="26"
                                     VerticalContentAlignment="Center"
                                     Margin="0,4,8,4"
                                     ToolTip="e.g. 27.0 or -10.0"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     DataObject.Pasting="NumericTextBox_Pasting"
                                     InputMethod.IsInputMethodEnabled="False"/>
                            <Button x:Name="SetTempButton"
                                    Content="Set"
                                    Padding="12,4"
                                    Margin="0,4,0,4"
                                    Click="SetTempButton_Click"
                                    ToolTip="Write target temperature"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Run / Stop"
                                   VerticalAlignment="Center"
                                   Margin="0,4,8,4"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="StartButton"
                                    Content="Start"
                                    Padding="12,4"
                                    Margin="0,4,8,4"
                                    Click="StartButton_Click"
                                    ToolTip="Start the chamber"/>
                            <Button x:Name="StopButton"
                                    Content="Stop"
                                    Padding="12,4"
                                    Margin="0,4,0,4"
                                    Click="StopButton_Click"
                                    ToolTip="Stop the chamber"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Temperature ramp -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16,12"
                CornerRadius="6"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Background="White">
            <StackPanel>
                <TextBlock Text="TEMPERATURE RAMP"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="TempRampStatusText"
                           Text="Idle"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Start (°C)" Margin="0,0,0,4"/>
                        <TextBox x:Name="StartTempTextBox"
                                 Width="70"
                                 Height="26"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Ramp start temperature, e.g. 25.0"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 DataObject.Pasting="NumericTextBox_Pasting"
                                 InputMethod.IsInputMethodEnabled="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="End (°C)" Margin="0,0,0,4"/>
                        <TextBox x:Name="EndTempTextBox"
                                 Width="70"
                                 Height="26"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Ramp end temperature, e.g. 60.0"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 DataObject.Pasting="NumericTextBox_Pasting"
                                 InputMethod.IsInputMethodEnabled="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time (s)" Margin="0,0,0,4"/>
                        <TextBox x:Name="DurationTempTextBox"
                                 Width="70"
                                 Height="26"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Ramp duration in whole seconds"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 DataObject.Pasting="NumericTextBox_Pasting"
                                 InputMethod.IsInputMethodEnabled="False"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="StartTempRampButton"
                            Content="Start"
                            Padding="12,4"
                            Margin="0,0,8,0"
                            Click="StartTempRampButton_Click"
                            ToolTip="Start the temperature linear ramp"/>
                    <Button x:Name="StopTempRampButton"
                            Content="Stop"
                            Padding="12,4"
                            Click="StopTempRampButton_Click"
                            ToolTip="Stop the temperature linear ramp"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
